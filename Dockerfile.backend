FROM python:3.12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y tesseract-ocr tesseract-ocr-eng tesseract-ocr-rus && rm -rf /var/lib/apt/lists/*

ARG UV_VERSION=0.11.15
RUN pip install --no-cache-dir "uv==${UV_VERSION}"

# Install the exact production dependency set from the checked-in lockfile.
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv export --frozen --no-dev --no-emit-project --format requirements-txt --output-file /tmp/requirements.lock \
    && uv pip install --system --require-hashes --no-deps --requirement /tmp/requirements.lock \
    && rm /tmp/requirements.lock

# Source is imported directly from /app; the project itself is intentionally
# excluded from the dependency layer so source-only changes keep that cache.
COPY backend/ ./
RUN mkdir -p /app/data /app/data/sandbox
EXPOSE 8000

CMD ["uvicorn", "quip.main:app", "--host", "0.0.0.0", "--port", "8000"]
