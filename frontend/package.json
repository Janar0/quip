{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"postbuild": "node scripts/generate-pwa.mjs && node scripts/check-pwa.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"overrides": {
		"katex": "$katex",
		"esbuild": "^0.28.2"
	},
	"devDependencies": {
		"@skeletonlabs/skeleton": "^4.15.0",
		"@skeletonlabs/skeleton-svelte": "^4.15.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/svelte": "^5.3.1",
		"@types/mustache": "^4.2.6",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^5.0.5",
		"jsdom": "^29.1.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"workbox-build": "^7.4.1"
	},
	"dependencies": {
		"@fontsource/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@fontsource/manrope": "^5.2.8",
		"chart.js": "^4.5.1",
		"highlight.js": "^11.11.1",
		"katex": "^0.18.2",
		"marked": "^17.0.6",
		"mermaid": "^11.14.0",
		"mustache": "^4.2.0",
		"svelte-i18n": "^4.0.1",
		"svelte-sonner": "^1.1.0"
	}
}
