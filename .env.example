# Optional JWT secret (at least 32 UTF-8 bytes when explicitly configured).
# Local and Docker startup both generate a persistent random secret when blank.
# Default file: backend/data/.jwt_secret locally, /app/data/.jwt_secret in Docker.
JWT_SECRET=
# Optional custom secret-file path for local/backend processes.
# JWT_SECRET_FILE=/absolute/path/to/.jwt_secret

# OpenRouter API key — can also be configured via Admin UI after first launch
OPENROUTER_API_KEY=

# Optional Qwen Audio realtime voice. Keep the provider key on the backend only.
# QwenCloud uses this WebRTC SDP endpoint and dedicated realtime model family.
QWEN_VOICE_ENABLED=false
QWEN_REALTIME_ENDPOINT=https://maas.qwencloudapi.com/api/v1/webrtc/realtime
QWEN_REALTIME_API_KEY=
QWEN_REALTIME_MODEL=qwen-audio-3.1-realtime-plus
# Enable only for a configured realtime model whose provider docs support video input.
QWEN_REALTIME_VIDEO_ENABLED=false

# Legacy setup metadata. An email address never authorizes an administrator claim.
# First-administrator registration always requires BOOTSTRAP_TOKEN.
ADMIN_EMAIL=

# One-time token required to claim the first administrator account.
# When omitted, QUIP generates one in data/.bootstrap_token and prints it once
# when the registration page checks first-run setup status.
BOOTSTRAP_TOKEN=

# Shared secret between the web app and the internal Docker executor.
# Set a random value (for example: openssl rand -hex 32) in production.
EXECUTOR_TOKEN=

# Port the app will be accessible on (default: 3000)
# PORT=3000

# Send session cookies only over HTTPS. Set to true behind a TLS reverse proxy.
COOKIE_SECURE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOGIN_REDIRECT_URI=
PUBLIC_APP_URL=
TELEGRAM_MAX_FILE_MB=20

# Optional SearXNG endpoint (defaults to local service in docker compose)
# For local dev, point to http://127.0.0.1:8888 when using docker-compose.dev.yml
SEARXNG_URL=

# SearXNG secret key used by the internal search service image
SEARXNG_SECRET=

# Recommended immutable release tag produced by GitHub Actions. Use the full
# 40-character git SHA to deploy matching app/sandbox releases; blank uses latest.
QUIP_IMAGE_TAG=

# Host directory for sandbox workspace persistence (default: ${PWD}/data/sandbox)
# Set this to an absolute path on your host machine. Sandbox files are stored here
# as bind-mounted directories and survive container restarts.
# QUIP_HOST_SANDBOX_DIR=/opt/quip/data/sandbox

# Optional HTTP proxy for local backend processes (only if your network needs it).
# Docker requires explicit forwarding through a Compose override; see docs/openrouter-network.md.
# HTTPS_PROXY=http://proxy-host:port
# HTTP_PROXY=http://proxy-host:port
# NO_PROXY=localhost,127.0.0.1,searxng,executor
